  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "fetch": "node scripts/fetch.ts",
    "build": "node scripts/build.ts",
    "test": "vitest run && tsc --noEmit",
    "lint": "prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "flatgeobuf": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
